{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Riffle WordPress theme demo",
		"description": "Installs the Riffle theme from GitHub, activates it and imports demo stories, including members-only posts.",
		"author": "mryan-code",
		"categories": [ "Themes" ]
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "installTheme",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/mryan-code/riffle-wp-theme",
				"ref": "main",
				"refType": "branch"
			},
			"options": {
				"activate": true,
				"targetFolderName": "riffle"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/themes/riffle/demo/seed.php';"
		}
	]
}
